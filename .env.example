# Copy this file to ".env" and fill in your Supabase project values.
# These are SAFE to ship in a frontend — the anon key is public by design,
# and the database is locked down to "insert only" (see README.md).
#
# Leave these blank and the app still works: responses are saved to the
# browser's localStorage and delivered via the "Copy plan & text me" button.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OPTIONAL — get pinged the instant she says yes (no DB needed for this).
# Paste a Discord channel webhook URL (Server Settings > Integrations > Webhooks)
# or a Slack incoming webhook. Leave blank to disable.
VITE_NOTIFY_WEBHOOK=
